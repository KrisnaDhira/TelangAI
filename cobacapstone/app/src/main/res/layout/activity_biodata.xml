<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/biodata_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    tools:context=".ui.activity.BiodataActivity">

    <!-- Barisan atas: Arrow + Question sejajar -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/top_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Tombol Back -->
        <ImageView
            android:id="@+id/btn_back"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/baseline_arrow_back_24"
            android:contentDescription="Back"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Judul Tengah -->
        <TextView
            android:id="@+id/tv_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tim Pengembang TelangAI"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="@color/black"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- ScrollView untuk daftar developer -->
    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        app:layout_constraintTop_toBottomOf="@id/top_row"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/developer_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Developer 1 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                android:background="@drawable/grey_bg"
                android:backgroundTint="@color/lightGrey">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/item_Image_1"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/title_image"
                        android:src="@drawable/danar"
                        app:shapeAppearanceOverlay="@style/RoundedImage" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/item_Text_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:justificationMode="inter_word"
                            android:maxLines="1"
                            android:text="Danar Rafiardi Ahmad"
                            android:textAlignment="textStart"
                            android:textColor="@color/black"
                            android:autoSizeTextType="none"
                            android:textSize="18dp"
                            android:textStyle="bold"
                             />

                        <TextView
                            android:id="@+id/item_Description_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="4"
                            android:text="Backend and Cloud Engineer"
                            android:textAlignment="textStart"
                            android:textColor="@color/black"
                            android:textSize="16dp"
                            android:autoSizeTextType="none"
                            />

                        <!-- Tombol Sosial Media -->
                        <LinearLayout
                            android:id="@+id/social_buttons_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            android:gravity="start">

                            <ImageButton
                                android:id="@+id/btn_github_1"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="GitHub"
                                android:src="@drawable/github30"
                                />

                            <ImageButton
                                android:id="@+id/btn_linkedin_1"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_marginStart="16dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="LinkedIn"
                                android:src="@drawable/linkedin30c" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Developer 2 -->
            <!-- Copy Developer 1, ganti ID jadi *_2 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                android:background="@drawable/grey_bg"
                android:backgroundTint="@color/lightGrey">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/item_Image_2"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/title_image"
                        android:src="@drawable/satya"
                        app:shapeAppearanceOverlay="@style/RoundedImage" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/item_Text_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:justificationMode="inter_word"
                            android:maxLines="1"
                            android:text="I Gede Satyananda G."
                            android:textAlignment="textStart"
                            android:textColor="@color/black"
                            android:autoSizeTextType="none"
                            android:textSize="18dp"
                            android:textStyle="bold"
                             />

                        <TextView
                            android:id="@+id/item_Description_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="4"
                            android:text="AI Engineer"
                            android:textAlignment="textStart"
                            android:textColor="@color/black"
                            android:textSize="16dp"
                            android:autoSizeTextType="none"
                             />

                        <!-- Tombol Sosial Media -->
                        <LinearLayout
                            android:id="@+id/social_buttons_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            android:gravity="start">

                            <ImageButton
                                android:id="@+id/btn_github_2"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="GitHub"
                                android:src="@drawable/github30"
                                />

                            <ImageButton
                                android:id="@+id/btn_linkedin_2"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_marginStart="16dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="LinkedIn"
                                android:src="@drawable/linkedin30c" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Developer 3 -->
            <!-- Copy lagi, ganti ID jadi *_3 -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="8dp"
                app:cardCornerRadius="8dp"
                app:cardElevation="4dp"
                android:background="@drawable/grey_bg"
                android:backgroundTint="@color/lightGrey">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:padding="8dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/item_Image_3"
                        android:layout_width="0dp"
                        android:layout_height="100dp"
                        android:layout_weight="1"
                        android:scaleType="centerCrop"
                        android:contentDescription="@string/title_image"
                        android:src="@drawable/krisna33"
                        app:shapeAppearanceOverlay="@style/RoundedImage" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:orientation="vertical"
                        android:paddingStart="8dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/item_Text_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:justificationMode="inter_word"
                            android:maxLines="1"
                            android:text="I Made Krisna Dhira M."
                            android:textAlignment="textStart"
                            android:textColor="@color/black"
                            android:autoSizeTextType="none"
                            android:textSize="18dp"
                            android:textStyle="bold"
                             />

                        <TextView
                            android:id="@+id/item_Description_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:ellipsize="end"
                            android:maxLines="4"
                            android:text="Android Developer"
                            android:textAlignment="textStart"
                            android:textColor="@color/black"
                            android:textSize="16dp"
                            android:autoSizeTextType="none"
                             />

                        <!-- Tombol Sosial Media -->
                        <LinearLayout
                            android:id="@+id/social_buttons_3"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:orientation="horizontal"
                            android:gravity="start">

                            <ImageButton
                                android:id="@+id/btn_github_3"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="GitHub"
                                android:src="@drawable/github30"
                                />

                            <ImageButton
                                android:id="@+id/btn_linkedin_3"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_marginStart="16dp"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                android:contentDescription="LinkedIn"
                                android:src="@drawable/linkedin30c" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
